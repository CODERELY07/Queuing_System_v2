APP_NAME=MedQueue
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# What "today" means. Every daily figure — tickets today, the live queue,
# "Delete Old Queues" — is computed in this timezone, so set it to where the
# clinic actually is (e.g. Asia/Manila). Left at UTC, the day rolls over in
# the middle of a working day anywhere east of Greenwich.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MySQL shown here. Production runs PostgreSQL (e.g. Supabase) — use the
# Session Pooler host/port and your pooler username (postgres.<project-ref>).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queuing_system
DB_USERNAME=root
DB_PASSWORD=

# `file`, not `database`: with a hosted database every request would pay
# extra round trips just to read and write the session and cache.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Real-time (Laravel Reverb). Set BROADCAST_CONNECTION=reverb to enable it;
# without it the pages still work and poll for updates instead.
# REVERB_APP_ID / KEY / SECRET: any random strings you generate.
# Locally REVERB_HOST=localhost, REVERB_PORT=8080, REVERB_SCHEME=http.
# Behind a reverse proxy (Render) use your public hostname, 443 and https.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Show the one-click demo-account panel on the login page (config/demo.php).
# Set to false for anything that isn't a portfolio demo.
DEMO_ACCOUNTS=true
